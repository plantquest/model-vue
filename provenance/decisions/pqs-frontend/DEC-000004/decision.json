  "outcome": "Single Vuex 3.4.0 store managing all application state with strict mutation/action patterns.",
  "rationale": "Complex state (sessions, assets, UI, map, NavVis) requires centralized management. Single source of truth, time travel debugging, predictable mutations, compatible with model-vue components.",
  "risk": {
    "level": "low",
    "acceptance": "Large single store (1660 lines) should be modularized but acceptable for Vue 2. Migration to Pinia required for Vue 3."
  },
  "scope": [
    "src/plugins/store.js",
    "src/**/*.vue (state access)",
    "src/components/** (dispatch/commit)"
  ],
