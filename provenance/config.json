{
  "decisionPath": "provenance/decisions",
  "riskApprovalThreshold": "medium",
  "requireDecisionOnPaths": [
    "src/",
    "infra/",
    "security/"
  ],
  "requireDecisionOnLabels": [
    "security",
    "breaking-change",
    "architecture"
  ],
  "allowNoDecisionForDocsOnly": true,
  "access": {
