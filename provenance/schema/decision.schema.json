{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProvenanceCode Decision Record",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "status",
    "context",
    "decision",
    "consequences",
    "links",
    "risk"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenancecode.decision.v2"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-\\d{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "accepted",
        "superseded"
      ]
    },
    "context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "consequences": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "required": [
        "pr"
      ],
      "properties": {
        "pr": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "related_mistakes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MR-\\d{6}$"
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "score",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "human": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "reviewed_by"
      ]
    },
    {
      "required": [
        "review"
      ],
      "properties": {
        "review": {
          "required": [
            "human"
          ]
        }
      }
    }
  ]
}
