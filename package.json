{
  "name": "@plantquest/model-vue-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for PlantQuest Model Vue - Vue 2 & Vue 3 versions",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:all": "pnpm -r build",
    "test:all": "pnpm -r test",
    "build:v2": "pnpm --filter @plantquest/model-vue-v2 vue-build",
    "build:v3": "pnpm --filter @plantquest/model-vue build",
    "dev:v3": "pnpm --filter @plantquest/model-vue dev",
    "preview:v3": "pnpm --filter @plantquest/model-vue preview",
    "lint:v3": "pnpm --filter @plantquest/model-vue lint"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plantquest/model-vue-2"
  },
  "author": "PlantQuest",
  "license": "MIT"
}
